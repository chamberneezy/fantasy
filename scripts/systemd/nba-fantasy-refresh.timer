[Unit]
Description=NBA Fantasy: evening refresh for injury news before US tip-off

[Timer]
# Box scores are the morning timer's job (nba-fantasy-morning.timer).
OnCalendar=*-*-* 18:00 Europe/Zurich
OnCalendar=*-*-* 23:30 Europe/Zurich
Persistent=true
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
