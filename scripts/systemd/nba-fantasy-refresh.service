[Unit]
Description=NBA Fantasy: refresh season feed (NBA + ESPN injuries) and publish the Pages copy
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/fantasy
# gh (for starting the Pages build, and as git's GitHub credential helper) comes from mise.
Environment=PATH=%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/Projects/fantasy/.venv/bin/python scripts/refresh_season.py --publish
